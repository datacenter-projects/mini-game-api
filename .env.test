# env ของ integration test / load test บนเครื่อง local (docs/TESTING.md)
# ค่าในไฟล์นี้ใช้กับ test env เท่านั้น ไม่มีความลับ — commit ได้
# pkg/testutil โหลดไฟล์นี้อัตโนมัติ — ข้ามทั้งไฟล์ถ้า environment มี DB_HOST อยู่แล้ว (เช่น CI) · ค่าที่ตั้งไว้แล้วไม่ถูกทับ
# ห้ามเขียน comment ต่อท้ายค่าในบรรทัดเดียวกัน

APP_ENV=local
SERVER_ADDR=:8282

# Postgres และ Redis ของ test env: docker-compose.test.yml หรือ scripts/testenv.ps1
DB_HOST=localhost
DB_PORT=55432
DB_USER=minigame
DB_PASSWORD=minigame
DB_NAME=minigame_test
DB_SSLMODE=disable

REDIS_ADDR=localhost:56379
REDIS_DB=0

JWT_SECRET=test-only-secret-at-least-32-characters-long
SESSION_IDLE_TIMEOUT=60m
SESSION_ABSOLUTE_TIMEOUT=12h
LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_WINDOW=15m
LOGIN_BLOCK_DURATION=15m
# load test ยิงจาก IP เดียว — เปิด limit กว้างไว้ (integration test ตั้งค่าเองใน test)
LOGIN_IP_LIMIT_PER_MINUTE=1000000
PASSCODE_FAIL_LIMIT=5
PASSCODE_FAIL_WINDOW=24h
PASSCODE_BLOCK_DURATION=1h
TEMP_CREDENTIAL_TTL=24h

MIGRATE_ON_START=true

# ข้อมูลรับรอง API (account ACC-04) — กุญแจของ test env เท่านั้น ห้ามใช้ที่อื่น
API_KEY_ENCRYPTION_KEY=Pbxnty+z3wHGN1ZZKPK3HOtX/7fXvAZKZtg489YNVWI=
