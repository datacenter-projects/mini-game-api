      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/bo/pb/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bo",
                "pb",
                "auth",
                "login"
              ]
            },
            "description": "เข้าสู่ระบบ — script จะเก็บ data.token ลงตัวแปร token ให้อัตโนมัติ (ใช้ Bearer ทุกเส้นใน /pr) · login ครั้งแรกอาจต้องตั้ง passcode/เปลี่ยน password ก่อน",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j && j.data && j.data.token) {",
                  "  pm.collectionVariables.set('token', j.data.token);",
                  "  console.log('token saved');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
