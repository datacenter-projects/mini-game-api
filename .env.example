# คัดลอกเป็น .env แล้วแก้ค่า — key ที่ไม่มี default ต้องใส่ ไม่งั้น boot ไม่ขึ้น
# เพิ่ม key ใหม่: เพิ่มใน pkg/configs/config.go และในไฟล์นี้ใน PR เดียวกัน

APP_ENV=local                 # local | dev | uat | prod

SERVER_ADDR=:8181
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=30s
TRUSTED_PROXIES=              # คั่นด้วย , เช่น 10.0.0.0/8
CORS_ALLOW_ORIGINS=*

# PostgreSQL (required: DB_HOST, DB_USER, DB_NAME)
DB_HOST=localhost
DB_PORT=5432
DB_USER=minigame
DB_PASSWORD=minigame
DB_NAME=minigame
DB_SSLMODE=disable            # local=disable, env อื่น=require
DB_READ_HOST=                 # ว่าง = ไม่ใช้ read replica
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# Redis (required: REDIS_ADDR)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

MIGRATE_ON_START=true         # local=true, env อื่นรัน migration แยกก่อน deploy
