# คัดลอกเป็น .env แล้วแก้ค่า — key ที่ไม่มี default ต้องใส่ ไม่งั้น boot ไม่ขึ้น
# เพิ่ม key ใหม่: เพิ่มใน pkg/configs/config.go และในไฟล์นี้ใน PR เดียวกัน
# ห้ามเขียน comment ต่อท้ายค่าในบรรทัดเดียวกัน (VS Code envFile จะอ่านเป็นส่วนหนึ่งของค่า)

# local | dev | uat | prod
APP_ENV=local

SERVER_ADDR=:8181
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=30s
# คั่นด้วย , เช่น 10.0.0.0/8 — ว่าง = ไม่เชื่อ X-Forwarded-For
TRUSTED_PROXIES=
CORS_ALLOW_ORIGINS=*
# server /metrics (Prometheus) พอร์ตภายใน แยกจาก API — ตั้งเป็นค่าว่าง = ปิด
METRICS_ADDR=:9090

# PostgreSQL (required: DB_HOST, DB_USER, DB_NAME)
DB_HOST=localhost
DB_PORT=5432
DB_USER=minigame
DB_PASSWORD=minigame
DB_NAME=minigame
# local=disable, env อื่น=require
DB_SSLMODE=disable
# ว่าง = ไม่ใช้ read replica
DB_READ_HOST=
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# Redis (required: REDIS_ADDR)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth หลังบ้าน (docs/modules/agent_auth.md) — required: JWT_SECRET (อย่างน้อย 32 ตัวอักษร)
JWT_SECRET=change-me-local-only-32-characters-min
# bcrypt cost (4–14) — prod 12, CI/test 4 ให้ test เร็ว
PASSWORD_COST=12
SESSION_IDLE_TIMEOUT=60m
SESSION_ABSOLUTE_TIMEOUT=12h
LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_WINDOW=15m
LOGIN_BLOCK_DURATION=15m
LOGIN_IP_LIMIT_PER_MINUTE=20
# docs/modules/agent_auth_phase2.md (AUTH-35, AUTH-46)
PASSCODE_FAIL_LIMIT=5
PASSCODE_FAIL_WINDOW=24h
PASSCODE_BLOCK_DURATION=1h
TEMP_CREDENTIAL_TTL=24h

# Object storage ของไฟล์ asset (docs/modules/asset.md) — ไม่ตั้ง S3_BUCKET = อัปโหลดไม่ได้ (505801) แต่ระบบยัง boot ได้
# credential ใช้ default chain ของ AWS SDK (IRSA บน k8s) — ห้ามใส่ access key ที่นี่
S3_REGION=ap-southeast-1
S3_BUCKET=
# base ของ URL รูปที่ตอบ client (เช่น https://cdn-dev.example.com) — ว่าง = ตอบเป็น key
S3_CDN_BASE_URL=
S3_UPLOAD_TIMEOUT=30s
# ว่าง = AWS จริง · ตั้งเมื่อใช้ S3 จำลองใน local (go run ./scripts/fakes3) เช่น http://127.0.0.1:9000 (ต้องตั้ง AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY เป็นค่าอะไรก็ได้ใน environment)
S3_ENDPOINT=

# local=true, env อื่นรัน migration แยกก่อน deploy
MIGRATE_ON_START=true

# เปิดเส้น dev (/api/v1/bo/pr/dev/... — ADMIN เท่านั้น) ให้ dev / QA เช็คผล เช่น คิด PT ต่อ Member · prod ตั้ง true แล้ว boot ไม่ขึ้น
DEV_ROUTES_ENABLED=false
